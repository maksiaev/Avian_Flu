cd /data/maksiaevai/11-01-2021--06-13-2025_cats/A3/PB1/; mafft --thread $SLURM_CPUS_PER_TASK A3_PB1_concat_11-01-2021--06-13-2025.fasta > A3_PB1_concat_11-01-2021--06-13-2025_aln.fasta
cd /data/maksiaevai/11-01-2021--06-13-2025_cats/A3/PB2/; mafft --thread $SLURM_CPUS_PER_TASK A3_PB2_concat_11-01-2021--06-13-2025.fasta > A3_PB2_concat_11-01-2021--06-13-2025_aln.fasta
