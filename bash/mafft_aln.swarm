cd /data/maksiaevai/11-01-2021--06-13-2025_cats/A3/NS/; mafft --thread $SLURM_CPUS_PER_TASK A3_NS_concat_11-01-2021--06-13-2025.fasta > A3_NS_concat_11-01-2021--06-13-2025_aln.fasta
cd /data/maksiaevai/11-01-2021--06-13-2025_cats/A3/NA/; mafft --thread $SLURM_CPUS_PER_TASK A3_NA_concat_11-01-2021--06-13-2025.fasta > A3_NA_concat_11-01-2021--06-13-2025_aln.fasta
